# syntax=docker/dockerfile:1

# Stage 1: build ik_llama.cpp from source with Zen4 (AMD EPYC Genoa / E48as_v5)
# IQK GEMM kernels via the HAVE_FANCY_SIMD path.
#
# Upstream cpu-swap image uses GGML_NATIVE=ON, which only enables Zen4 features
# if the CI build host happens to be Zen4. To guarantee Zen4 performance on
# E48as_v5 (and the upcoming v7), we build explicitly with the AVX-512 family
# flags documented in ik_llama.cpp's docs/build.md "CPU build flags for AVX-512".
FROM ubuntu:24.04 AS ik-llama-builder

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libcurl4-openssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ikawrakow/ik_llama.cpp.git /src

WORKDIR /src

# Zen4 / AVX-512 build: GGML_NATIVE + the four GGML_AVX512_* flags are the
# shortest path that flips HAVE_FANCY_SIMD on (per docs/build.md). The
# IQK quantized matmul hot path then uses 256-bit double-pumped AVX-512
# (vnni + vbmi + bf16) on Zen4 — ~30-50% faster than the AVX2 fallback.
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DGGML_NATIVE=ON \
        -DGGML_AVX512=ON \
        -DGGML_AVX512_VBMI=ON \
        -DGGML_AVX512_VNNI=ON \
        -DGGML_AVX512_BF16=ON \
        -DGGML_OPENMP=ON \
        -DGGML_IQK_FA_ALL_QUANTS=ON

RUN cmake --build build --config Release -j"$(nproc)" --target llama-server

# Stage 2: runtime — use upstream cpu-swap image as base for llama-swap +
# base libs, then replace /app/llama-server with our Zen4-optimized build.
# llama-swap (config.yaml driven) keeps working unchanged; only the
# downstream llama-server binary gets the Zen4 IQK kernels.
FROM ghcr.io/ikawrakow/ik-llama-cpp:cpu-swap

COPY --from=ik-llama-builder /src/build/bin/llama-server /app/llama-server

# Per-model llama-swap config (set by --build-arg from the workflow).
# ARG MODEL_CONFIG is the path (relative to build context) to the per-model config.yaml.
ARG MODEL_CONFIG=config.yaml
COPY ${MODEL_CONFIG} /app/config.yaml

# --- Sharded GGUF layers (auto-generated by .github/workflows/build.yml) ---
# Each sharded GGUF becomes its own image layer because the GHCR per-layer
# limit is 10 GB; the full GGUF would otherwise fail to push.
# Shard naming follows llama-gguf-split: <input>-NNNNN-of-NNNNN.gguf.