FROM ghcr.io/ikawrakow/ik-llama-cpp:cpu-swap

# llama-swap configuration (small, changes don't bust the heavy GGUF layer cache).
# ARG MODEL_CONFIG is the path (relative to build context) to the per-model config.yaml.
ARG MODEL_CONFIG=config.yaml
COPY ${MODEL_CONFIG} /app/config.yaml

# --- Sharded GGUF layers (auto-generated by .github/workflows/build.yml) ---
# Each sharded GGUF becomes its own image layer because the GHCR per-layer
# limit is 10 GB; the full Ornith Q4_K_M (~21 GB) would otherwise fail to push.