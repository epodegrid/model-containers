# syntax=docker/dockerfile:1

# Multi-stage build that compiles ik_llama.cpp for Zen 3, Zen 4, and Zen 5,
# then bundles all three binaries in one runtime image. A wrapper at
# /app/llama-server detects the host CPU at startup (via /proc/cpuinfo)
# and exec's the matching binary, so the same image runs unmodified on
# whatever Azure decides to give us (Milan/Zen3, Genoa/Zen4, or Turin/Zen5).
#
# Build flags per ISA:
#   Zen 3 (Milan): -march=znver3            (AVX2 only - Zen 3 has NO AVX-512)
#   Zen 4 (Genoa): -march=znver4            (adds VL)
#   Zen 5 (Turin): -march=znver4 + Zen5 ISAs (adds VNNI/BF16/VBMI/VBMI2)
#
# GCC 13 (Ubuntu 24.04 default) doesn't recognize `-march=znver5`
# (added in GCC 14); we emulate it with the equivalent ISA flags. Same
# instruction set is emitted, runs unchanged on real Zen 5 silicon.

# -----------------------------------------------------------------------------
# Stage `base`: shared build deps + ik_llama.cpp source. Each ISA builder
# extends from this stage so the apt install and git clone happen once.
# -----------------------------------------------------------------------------
FROM ubuntu:24.04 AS base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
        || (echo "apt-get update failed, retrying in 30s..." && sleep 30 && apt-get update) \
        || (echo "apt-get update failed again, retrying in 60s..." && sleep 60 && apt-get update) \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libcurl4-openssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ikawrakow/ik_llama.cpp.git /src

# -----------------------------------------------------------------------------
# Zen 3 (Milan) — AVX2/FMA/BMI2. AMD did not ship AVX-512 until Zen 4
# (Genoa), so this is the AVX2 fallback path and the binary our target
# SKU (Azure E48as_v5 = EPYC 7763v Milan) actually runs.
# HAVE_FANCY_SIMD is NOT defined here (gated on VNNI).
# -----------------------------------------------------------------------------
FROM base AS zen3-builder
WORKDIR /src
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF \
        -DCMAKE_C_FLAGS="-march=znver3" \
        -DCMAKE_CXX_FLAGS="-march=znver3" \
        -DGGML_OPENMP=ON \
        -DGGML_IQK_FA_ALL_QUANTS=ON
RUN cmake --build build --config Release -j"$(nproc)" --target llama-server
RUN mkdir -p /out && cp build/bin/llama-server /out/llama-server.zen3

# -----------------------------------------------------------------------------
# Zen 4 (Genoa) — adds AVX-512VL. Runs on Zen 4 natively. Crashes on
# Zen 3 (no VL) and on Zen 5 only if VNNI instructions are emitted
# (they aren't with this build, so it's safe on Zen 5 too, just
# missing the Zen 5-specific IQK VNNI kernels).
# -----------------------------------------------------------------------------
FROM base AS zen4-builder
WORKDIR /src
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF \
        -DCMAKE_C_FLAGS="-march=znver4" \
        -DCMAKE_CXX_FLAGS="-march=znver4" \
        -DGGML_OPENMP=ON \
        -DGGML_IQK_FA_ALL_QUANTS=ON
RUN cmake --build build --config Release -j"$(nproc)" --target llama-server
RUN mkdir -p /out && cp build/bin/llama-server /out/llama-server.zen4

# -----------------------------------------------------------------------------
# Zen 5 (Turin) — adds VNNI/BF16/VBMI/VBMI2 to the Zen 4 set. HAVE_FANCY_SIMD
# flips on, so the IQK VNNI kernels are selected at runtime. Crashes on
# Zen 3 (no VL) and on Zen 4 (no VNNI). Use this only on real Zen 5 hardware.
# -----------------------------------------------------------------------------
FROM base AS zen5-builder
WORKDIR /src
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF \
        -DCMAKE_C_FLAGS="-march=znver4 -mavx512vnni -mavx512bf16 -mavx512vbmi -mavx512vbmi2" \
        -DCMAKE_CXX_FLAGS="-march=znver4 -mavx512vnni -mavx512bf16 -mavx512vbmi -mavx512vbmi2" \
        -DGGML_OPENMP=ON \
        -DGGML_IQK_FA_ALL_QUANTS=ON
RUN cmake --build build --config Release -j"$(nproc)" --target llama-server
RUN mkdir -p /out && cp build/bin/llama-server /out/llama-server.zen5

# -----------------------------------------------------------------------------
# Stage `runtime`: use upstream cpu-swap image as base for llama-swap +
# base libs. Bundle all three ISA-built llama-server binaries plus the
# CPU-detecting wrapper. llama-swap still uses /app/llama-server as the
# cmd path in config.yaml — the wrapper transparently dispatches to the
# right binary.
# -----------------------------------------------------------------------------
FROM ghcr.io/ikawrakow/ik-llama-cpp:cpu-swap

COPY --from=zen3-builder /out/llama-server.zen3 /app/llama-server.zen3
COPY --from=zen4-builder /out/llama-server.zen4 /app/llama-server.zen4
COPY --from=zen5-builder /out/llama-server.zen5 /app/llama-server.zen5

# Wrapper replaces the upstream /app/llama-server. Detects host CPU and
# exec's the matching binary.
COPY wrapper.sh /app/llama-server
RUN chmod +x /app/llama-server

# Per-model llama-swap config (set by --build-arg from the workflow).
# ARG MODEL_CONFIG is the path (relative to build context) to the per-model config.yaml.
ARG MODEL_CONFIG=config.yaml
COPY ${MODEL_CONFIG} /app/config.yaml

# --- Sharded GGUF layers (auto-generated by .github/workflows/build.yml) ---
# Each sharded GGUF becomes its own image layer because the GHCR per-layer
# limit is 10 GB; the full GGUF would otherwise fail to push.
# Shard naming follows llama-gguf-split: <input>-NNNNN-of-NNNNN.gguf.