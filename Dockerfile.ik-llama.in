# syntax=docker/dockerfile:1

# Stage 1: build ik_llama.cpp from source, targeting a specific AMD Zen ISA.
#
# Pass `ARCH=4` (Zen 4 / EPYC Genoa / current E48as_v5) or `ARCH=5` (Zen 5 /
# upcoming E48as_v7) via --build-arg. Defaults to ARCH=4.
#
# We target the ISA explicitly with `-march=znver${ARCH}` rather than
# relying on `GGML_NATIVE=ON`. The latter resolves to `-march=native` on
# whatever the build host happens to be (Cascade Lake, Sapphire Rapids,
# etc. on GitHub Actions), and GGML_AVX512=ON in upstream's CMakeLists
# adds `-mavx512f -mavx512bw` but NOT `-mavx512dq` — which breaks the
# `v_tanh(__m512)` overload (gated on `__AVX512F__ && __AVX512DQ__`).
# `-march=znver${ARCH}` is reproducible across CI host CPU changes.
#
# Zen 4 lacks AVX-512 VNNI / BF16 / VBMI (those are Zen 5), so
# HAVE_FANCY_SIMD is *not* defined for ARCH=4 — we get the AVX-512 base
# path (Zen 4's 256-bit double-pumped ops, ~30-50% over AVX2). For
# ARCH=5, HAVE_FANCY_SIMD flips on automatically because znver5 has VNNI.
FROM ubuntu:24.04 AS ik-llama-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG ARCH=4

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libcurl4-openssl-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ikawrakow/ik_llama.cpp.git /src

WORKDIR /src

# Explicit Zen N target.
#
# GCC 13 (Ubuntu 24.04 default) doesn't know `-march=znver5` — that
# value was added in GCC 14. For ARCH=5 we emulate Zen 5 with `znver4`
# + the Zen 5-only AVX-512 extensions. The instruction set produced
# is the same one GCC 14's `-march=znver5` emits. On real Zen 5
# hardware this binary will run correctly; on Zen 4 hardware it
# would crash (illegal VNNI/BF16/VBMI/VBMI2). When we move to a base
# image with GCC 14+, switch this back to `-march=znver${ARCH}`.
RUN if [ "$ARCH" = "5" ]; then \
        MARCH_FLAGS="-march=znver4 -mavx512vnni -mavx512bf16 -mavx512vbmi -mavx512vbmi2"; \
    else \
        MARCH_FLAGS="-march=znver4"; \
    fi && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DGGML_NATIVE=OFF \
        -DCMAKE_C_FLAGS="$MARCH_FLAGS" \
        -DCMAKE_CXX_FLAGS="$MARCH_FLAGS" \
        -DGGML_OPENMP=ON \
        -DGGML_IQK_FA_ALL_QUANTS=ON

RUN cmake --build build --config Release -j"$(nproc)" --target llama-server

# Stage 2: runtime — use upstream cpu-swap image as base for llama-swap +
# base libs, then replace /app/llama-server with our Zen-N build.
# llama-swap (config.yaml driven) keeps working unchanged; only the
# downstream llama-server binary is rebuilt for the target ISA.
FROM ghcr.io/ikawrakow/ik-llama-cpp:cpu-swap

COPY --from=ik-llama-builder /src/build/bin/llama-server /app/llama-server

# Per-model llama-swap config (set by --build-arg from the workflow).
# ARG MODEL_CONFIG is the path (relative to build context) to the per-model config.yaml.
ARG MODEL_CONFIG=config.yaml
COPY ${MODEL_CONFIG} /app/config.yaml

# --- Sharded GGUF layers (auto-generated by .github/workflows/build.yml) ---
# Each sharded GGUF becomes its own image layer because the GHCR per-layer
# limit is 10 GB; the full GGUF would otherwise fail to push.
# Shard naming follows llama-gguf-split: <input>-NNNNN-of-NNNNN.gguf.