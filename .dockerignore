# Build infrastructure (not needed in any image)
.git/
.github/
.gitignore
.dockerignore
LICENSE
README.md

# Templates only — workflow reads them to generate the final Dockerfile,
# but they don't belong inside any built image.
Dockerfile.ik-llama.in
go-4/Dockerfile.go-4.in

# wrapper.sh is staged into the ik_llama images, so DO ship it.

# llama.cpp clone (built in CI for ik_llama sharding, then deleted)
llama.cpp/

# Default-exclude model files; the !-prefixed lines below re-include
# the specific ones each image needs.
*.gguf

# Default-exclude go-4 snapshot directories; re-include below.
go-4-snapshot-text
go-4-snapshot-text/**
go-4-snapshot-vision
go-4-snapshot-vision/**

# Re-include sharded GGUFs (eve + wall-e)
!ornith-1.0-35b-Q5_K_M-*.gguf
!ornith-1.0-9b-Q8_0-*.gguf

# Re-include go-4 snapshots
!go-4-snapshot-text
!go-4-snapshot-text/**
!go-4-snapshot-vision
!go-4-snapshot-vision/**