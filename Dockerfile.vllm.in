FROM vllm/vllm-openai:latest

# Pre-downloaded Qwen3.5-9B safetensors snapshot is baked in as individual
# layers (one COPY per file, ordered largest-first so config/tokenizer edits
# don't invalidate the heavy safetensors layer cache). See the workflow for
# COPY-line generation.

EXPOSE 8000

ENTRYPOINT ["vllm", "serve"]
CMD ["--model", "/models/qwen3.5-9b", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--tensor-parallel-size", "1", \
     "--max-model-len", "32768", \
     "--reasoning-parser", "qwen3", \
     "--enable-auto-tool-choice", \
     "--tool-call-parser", "qwen3_coder", \
     "--language-model-only"]