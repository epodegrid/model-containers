# syntax=docker/dockerfile:1

# go-4: multimodal embedding service for nomic-embed-vision-v1.5 + nomic-embed-text-v1.5.
# ik_llama.cpp can't do this — its vision support is for multimodal CHAT
# (vision feeds into an LLM decoder), not standalone image-embedding
# servers. So we wrap the HuggingFace transformers model directly in a
# small FastAPI service.
#
# This is a single image (Python + PyTorch runtime dispatches the right ISA
# at runtime), but we accept ARCH=4/5 from the workflow for build-arg
# uniformity with the ik_llama matrix entries.
FROM python:3.11-slim

ARG ARCH=4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# OS-level deps for Pillow (libjpeg/zlib/etc.) and the build chain.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        libjpeg-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Python deps. PyTorch CPU wheels from the official index so we don't
# pull the (huge) CUDA-enabled default.
COPY go-4/requirements.txt /app/requirements.txt
# torch + torchvision both come from PyTorch's CPU index; pip needs both
# package lines to share the same --index-url, which the per-line syntax
# in requirements.txt handles cleanly.
RUN pip install --no-cache-dir -r /app/requirements.txt

# Service code.
COPY go-4/service.py /app/service.py

# Pre-baked model snapshots — CI downloads both repos from Hugging Face
# to these exact paths before docker build runs (so the build context
# includes them). Each snapshot is one COPY, one layer, well under the
# GHCR 10 GB per-layer limit (~440 MB text, ~370 MB vision).
COPY go-4-snapshot-text/    /models/nomic-embed-text-v1.5/
COPY go-4-snapshot-vision/  /models/nomic-embed-vision-v1.5/

# Both model repos declare their code in a THIRD repo via auto_map's cross-repo
# syntax ("nomic-ai/nomic-bert-2048--modeling_hf_nomic_bert.NomicBertModel").
# Shipping only the model snapshots means the first trust_remote_code load
# still calls out to huggingface.co, which crashloops in an air-gapped
# cluster. Copy those modules next to each config.json and strip the
# "<repo>--" prefix so the classes resolve locally, with no network and no HF
# cache to keep in sync. HF_SNAPSHOT_PATTERNS limits this repo to *.py, so it
# costs ~105 KB rather than the ~1 GB of weights we never load.
COPY go-4-snapshot-code/    /tmp/nomic-code/
COPY go-4/vendor_remote_code.py /tmp/vendor_remote_code.py
RUN python /tmp/vendor_remote_code.py /tmp/nomic-code \
        /models/nomic-embed-text-v1.5 \
        /models/nomic-embed-vision-v1.5 \
    && rm -rf /tmp/nomic-code /tmp/vendor_remote_code.py

ENV TEXT_MODEL_PATH=/models/nomic-embed-text-v1.5
ENV VISION_MODEL_PATH=/models/nomic-embed-vision-v1.5

# Everything the service needs is baked in, so forbid Hub access outright.
# In an air-gapped cluster the request would fail anyway — failing fast and
# locally beats a connection timeout on every pod start, and it turns any
# future "this quietly downloads something" regression into a build-time
# failure instead of a production crashloop.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# Use 8080 to match the eve/wall-e images (llama-swap also on 8080) —
# AKS Services don't have to know which engine is in each pod.
EXPOSE 8080

CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8080"]